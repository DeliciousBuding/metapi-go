# Normalize line endings for all text files (LF in the repository index)
* text=auto eol=lf

# Shell scripts must stay LF even on Windows checkouts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets — never treat as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
