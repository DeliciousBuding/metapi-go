{
  "name": "metapi-desktop",
  "version": "0.12.0",
  "description": "Minimal Electron desktop shell for the Metapi Go server. Wraps the web admin UI, manages the Go binary lifecycle, and provides a system-tray with quick actions.",
  "main": "main.js",
  "private": true,
  "author": "Metapi Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . metapi-desktop --out=dist --overwrite --icon=tray-icon.png --prune=true --ignore=\"dist|node_modules|\\.gitignore|README\\.md\""
  },
  "config": {
    "metapi": {
      "adminUrl": "http://127.0.0.1:4000",
      "healthPath": "/api/desktop/health",
      "notificationsPath": "/api/admin/notifications",
      "pollIntervalMs": 2000
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
