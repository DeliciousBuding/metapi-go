#!/bin/bash
# Metapi-Go project pre-push gate — run full local CI before pushing.
# Managed installs: the global hook-kit chains .githooks/pre-push-project.
# Standalone installs: .githooks/pre-push is a thin compatibility wrapper.
# Skip with: git push --no-verify (emergency only).
set -euo pipefail

# A push that only deletes refs changes no branch content, so it does not
# need the full CI gate. Deletes arrive on stdin as:
#   <local-ref> <40-zero-oid> <remote-ref> <remote-oid>
while read -r _local_ref local_oid _remote_ref _remote_oid; do
	if [ "$local_oid" != "0000000000000000000000000000000000000000" ]; then
		delete_only=0
		break
	fi
	delete_only=1
done
if [ "${delete_only:-0}" = "1" ]; then
	echo "=============================================="
	echo "pre-push: only ref deletions — skipping local CI"
	echo "=============================================="
	exit 0
fi

echo "=============================================="
echo "pre-push: running local CI (frontend + build + vet + test -race)"
echo "=============================================="

# 1. Frontend gate — the Go binary embeds web/dist, so a fresh clone must
# build the tested frontend before compiling cmd/server. Bun is mandatory.
echo ""
echo "[1/4] frontend gate (test + typecheck + lint + format + knip + build)"
if ! command -v bun >/dev/null 2>&1; then
	echo "  ✗ bun not found — cannot build the embedded SPA" >&2
	exit 1
fi
(cd web && bun run test && bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run build:check)
echo "  ✓ frontend passed"

# 2. go build — compile only after web/dist has been generated.
echo ""
echo "[2/4] go build ./cmd/server"
go build ./cmd/server
echo "  ✓ build passed"

# 3. go vet — fast static analysis
echo ""
echo "[3/4] go vet ./..."
go vet ./...
echo "  ✓ vet passed"

# 4. full test suite with race detector
echo ""
echo "[4/4] race gate (native Unix, WSL-backed on Windows)"
bash ./scripts/go-race.sh
echo "  ✓ tests passed (-race clean)"

echo ""
echo "=============================================="
echo "pre-push OK — all checks passed"
echo "=============================================="
