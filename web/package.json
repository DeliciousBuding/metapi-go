{
  "name": "metapi",
  "version": "0.9.0",
  "private": true,
  "description": "Meta-layer management and unified proxy for AI API aggregation platforms",
  "keywords": [
    "ai",
    "api-gateway",
    "proxy",
    "rsbuild",
    "react",
    "openai",
    "claude",
    "aggregator"
  ],
  "homepage": "https://github.com/DeliciousBuding/metapi-go#readme",
  "bugs": {
    "url": "https://github.com/DeliciousBuding/metapi-go/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeliciousBuding/metapi-go.git"
  },
  "license": "MIT",
  "author": {
    "name": "DeliciousBuding",
    "url": "https://github.com/DeliciousBuding"
  },
  "engines": {
    "bun": ">= 1.0"
  },
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run build:web",
    "build:web": "bun run desktop:icons && rsbuild build",
    "build:check": "tsgo -b && bun run build",
    "typecheck": "tsgo -b",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "rsbuild preview",
    "desktop:icons": "node scripts/desktop/generate-icons.mjs",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-table": "^8.21.3",
    "@visactor/react-vchart": "^2.1.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "recharts": "3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.4",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260702.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "oxlint": "^1.72.0",
    "react-test-renderer": "^19.2.7",
    "shadcn": "^4.12.0",
    "sharp": "^0.34.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "2.1.1",
    "dompurify": "3.4.11",
    "fast-uri": "3.1.2",
    "hono": "4.12.22",
    "ip-address": "10.2.0",
    "js-cookie": "3.0.7",
    "mermaid": "11.15.0",
    "minimist": "1.2.8",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "uuid": "14.0.0"
  }
}
